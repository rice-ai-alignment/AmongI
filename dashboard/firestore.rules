rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Studies ──────────────────────────────────────────────────
    match /studies/{studyId} {
      // Anyone can read studies (public dashboard)
      allow read: if true;

      // Only authenticated users can create studies
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;

      // Only the study owner can update or delete
      allow update, delete: if resource.data.owner == request.auth.uid;

      // ── Experiments ────────────────────────────────────────────
      match /experiments/{experimentCode} {
        // Anyone can read experiments and their games
        allow read: if true;

        // Only the parent study's owner can create/modify experiments
        allow create: if request.auth != null
                      && get(/databases/$(database)/documents/studies/$(studyId)).data.owner == request.auth.uid;

        allow update, delete: if get(/databases/$(database)/documents/studies/$(studyId)).data.owner == request.auth.uid;

        // ── Games ────────────────────────────────────────────────
        match /games/{gameId} {
          // Anyone can read game recaps
          allow read: if true;

          // Study owner or server (admin SDK) can write
          allow write: if get(/databases/$(database)/documents/studies/$(studyId)).data.owner == request.auth.uid;

          // Trace subcollection (per-game event logs)
          match /trace/{traceId} {
            allow read: if true;
            allow write: if get(/databases/$(database)/documents/studies/$(studyId)).data.owner == request.auth.uid;
          }
        }

        // ── Archived Data ─────────────────────────────────────────
        match /archived_data/{archiveId} {
          // Study owner can read, create, delete archived snapshots
          allow read, write: if get(/databases/$(database)/documents/studies/$(studyId)).data.owner == request.auth.uid;

          match /games/{gameId} {
            allow read, write: if get(/databases/$(database)/documents/studies/$(studyId)).data.owner == request.auth.uid;
          }
        }
      }
    }

    // ── Servers ──────────────────────────────────────────────────
    match /servers/{serverId} {
      // Anyone can read server status (public dashboard)
      allow read: if true;
      // Only Admin SDK (server handler) writes — no client write allowed
      allow write: if false;
    }

    // ── Jobs ─────────────────────────────────────────────────────
    match /jobs/{jobId} {
      // Anyone can read jobs (public experiment status pages)
      allow read: if true;

      // Authenticated users can create queued jobs
      allow create: if request.auth != null
                    && request.resource.data.created_by == request.auth.uid
                    && request.resource.data.status == "queued";

      // Users can update their own jobs (cancel only — status transitions
      // are handled by server Admin SDK which bypasses rules)
      allow update: if request.auth != null
                    && resource.data.created_by == request.auth.uid;

      allow delete: if false;
    }

    // ── Server Usage ─────────────────────────────────────────────
    match /server_usage/{docId} {
      // Anyone can read usage logs
      allow read: if true;
      // Only Admin SDK writes — no client write allowed
      allow write: if false;
    }

    // ── Tokens ────────────────────────────────────────────────────
    match /tokens/{tokenId} {
      // Only admins can read/write tokens (they contain API keys)
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for admin panel)
      allow read: if request.auth != null;

      // Users can create their own profile (with can_run_experiments forced to false)
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.can_run_experiments == false;

      // Admins can update any user (including permissions).
      // Guard: updating a doc that currently has is_admin:true must
      // explicitly include is_admin in the request — prevents a full-doc
      // .set() from silently wiping admin status (field dropped → denied).
      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true
                    && (!resource.data.get('is_admin', false)
                        || request.resource.data.keys().hasAll(['is_admin']));

      // Non-admin users can update their own profile but cannot change permissions
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.can_run_experiments == resource.data.can_run_experiments
                    && request.resource.data.is_admin == resource.data.is_admin;

      allow delete: if false;
    }
  }
}
