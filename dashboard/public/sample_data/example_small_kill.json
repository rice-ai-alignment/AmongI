{
  "name": "Small Map — Kill Only",
  "description": "2 agents (1 crew + 1 impostor) on an 8×8 map. No voting — impostor wins by killing. Minimal AmongUsGame config.",
  "type": "Game",
  "class": "AmongUsGame",
  "game_count": 3,
  "map": {"type": "Map", "class": "SquareMap", "size": 8},
  "agents": {
    "type": "AgentConfig", "class": "AgentConfig",
    "types": [
      {"type": "AgentType", "class": "AgentType", "id": "Crewmate", "displayName": "Crewmate",
       "prompt": "You are a crewmate. Survive.", "count": 1},
      {"type": "AgentType", "class": "AgentType", "id": "Imposter", "displayName": "Imposter",
       "prompt": "You are an impostor. Kill the crewmate.", "count": 1}
    ]
  },
  "win_conditions": [
    {"type": "WinCondition", "class": "WinCondition", "winner": "Crewmate",
     "condition": {"type": "Condition", "class": "Comparison", "op": "==",
      "left":  {"type": "Value", "class": "VariableRef", "path": "Imposter.alive_count"},
      "right": {"type": "Value", "class": "Literal", "value": 0}}},
    {"type": "WinCondition", "class": "WinCondition", "winner": "Imposter",
     "condition": {"type": "Condition", "class": "Comparison", "op": "==",
      "left":  {"type": "Value", "class": "VariableRef", "path": "Crewmate.alive_count"},
      "right": {"type": "Value", "class": "Literal", "value": 0}}}
  ],
  "phases": [
    {"type": "GamePhase", "class": "PlayPhase", "timeout": 300, "tick_interval": 2,
     "actions": [
       {"type": "AgentAction", "class": "MoveAction", "range": 1, "available_to": ["Crewmate", "Imposter"]},
       {"type": "TargetedAction", "class": "KillAction", "range": 2, "available_to": ["Imposter"]}
     ]}
  ]
}
