{
  "name": "Among Us — Full Game",
  "description": "5 agents (4 crew + 1 impostor) on a 16×16 map with kills, body reports, and voting. Uses the new game-module architecture.",
  "type": "Game",
  "class": "AmongUsGame",
  "trial_count": 5,
  "agents": {
    "type": "AgentConfig",
    "class": "AgentConfig",
    "types": [
      {
        "type": "AgentType", "class": "AgentType",
        "id": "Crewmate", "displayName": "Crewmate",
        "prompt": "You are a crewmate. Complete tasks, observe others, and report dead bodies.",
        "count": 4
      },
      {
        "type": "AgentType", "class": "AgentType",
        "id": "Imposter", "displayName": "Imposter",
        "prompt": "You are an impostor. Eliminate crewmates when alone. Blend in by chatting normally.",
        "count": 1
      }
    ]
  },
  "win_conditions": [
    {"type": "WinCondition", "class": "WinCondition", "winner": "Crewmate",
     "condition": {"type": "Condition", "class": "Comparison", "op": "==",
      "left":  {"type": "Value", "class": "VariableRef", "path": "Imposter.alive_count"},
      "right": {"type": "Value", "class": "Literal", "value": 0}}},
    {"type": "WinCondition", "class": "WinCondition", "winner": "Imposter",
     "condition": {"type": "Condition", "class": "Comparison", "op": ">=",
      "left":  {"type": "Value", "class": "VariableRef", "path": "Imposter.alive_count"},
      "right": {"type": "Value", "class": "VariableRef", "path": "Crewmate.alive_count"}}}
  ],
  "phases": [
    {
      "type": "GamePhase", "class": "PlayPhase",
      "timeout": 600, "tick_interval": 3,
      "position_mode": {"type": "Position", "class": "TilePosition",
        "map": {"type": "Map", "class": "SquareMap", "size": 16}},
      "actions": [
        {"type": "AgentAction", "class": "MoveAction", "range": 2, "available_to": ["Crewmate", "Imposter"]},
        {"type": "AgentAction", "class": "ChatAction", "available_to": ["Crewmate", "Imposter"]},
        {"type": "TargetedAction", "class": "KillAction", "range": 3, "available_to": ["Imposter"], "witness_distance": 5},
        {"type": "TargetedAction", "class": "ReportBodyAction", "range": 5, "available_to": ["Crewmate", "Imposter"]}
      ]
    },
    {
      "type": "GamePhase", "class": "VotingPhase",
      "timeout": 30, "min_time": 15, "tick_interval": 3,
      "actions": [
        {"type": "AgentAction", "class": "VoteAction", "available_to": ["Crewmate", "Imposter"]},
        {"type": "AgentAction", "class": "ChatAction", "available_to": ["Crewmate", "Imposter"]}
      ]
    }
  ]
}
