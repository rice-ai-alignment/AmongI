  "Value": {
    "description": "Value components",
    "classes": {
      "Literal": {
        "description": "A constant value embedded directly in the config.",
        "params": {
          "value": {
            "type": "object",
            "default": null,
            "description": "The constant value"
          }
        },
        "source": "components/expressions.py"
      },
      "VariableRef": {
        "description": "Reference an exposed variable by dotted path.\n\n    Paths like ``\"engine._game_kills\"`` or ``\"self.tile.x\"`` are resolved\n    by the ConditionContext's ``resolve()`` method.",
        "params": {
          "path": {
            "type": "str",
            "default": "''",
            "description": "Dotted path to an exposed variable"
          }
        },
        "source": "components/expressions.py"
      },
      "FunctionCall": {
        "description": "Call an exposed function with expression arguments.\n\n    ``function`` is a dotted path to a callable (e.g. ``\"map.distance\"``).\n    ``args`` are sub-expressions evaluated before the call.",
        "params": {
          "function": {
            "type": "str",
            "default": "''",
            "description": "Dotted path to an exposed function"
          },
          "args": {
            "type": "list",
            "default": "[]",
            "description": "Argument expressions"
          }
        },
        "source": "components/expressions.py"
      },
      "MathOp": {
        "description": "Binary math operation on two expressions.\n\n    ``op`` is one of + - * / %.\n    ``left`` and ``right`` are sub-expressions evaluated before the operation.",
        "params": {
          "op": {
            "type": "str",
            "default": "'+'",
            "description": "Operator: + - * / %"
          },
          "left": {
            "type": "component",
            "default": null,
            "description": "Left-hand expression"
          },
          "right": {
            "type": "component",
            "default": null,
            "description": "Right-hand expression"
          }
        },
        "source": "components/expressions.py"
      }
    }
  },
