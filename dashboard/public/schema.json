  "AgentType": {
    "description": "AgentType components",
    "classes": {
      "AgentType": {
        "description": "One agent type \u2014 its id, display name, prompt, and spawn count.\n\n    ``id`` is the machine-readable key used in references\n    (``available_to``, ``VariableRef`` paths, ``alive_count``, etc.).\n    ``displayName`` is the human-readable label shown in the UI.\n\n    Actions are defined in phases (FreeRoamPhase.actions, VotingPhase.actions)\n    with ``available_to`` lists \u2014 not duplicated here.",
        "params": {
          "id": {
            "type": "str",
            "default": "''",
            "description": "Machine-readable identifier (used in references)"
          },
          "displayName": {
            "type": "str",
            "default": "''",
            "description": "Human-readable display name"
          },
          "prompt": {
            "type": "str",
            "default": "''",
            "description": "System prompt for this agent type"
          },
          "model": {
            "type": "str",
            "default": "''",
            "description": "OpenRouter model ID for this agent type (overrides default)"
          },
          "count": {
            "type": "int",
            "default": "1",
            "description": "How many agents of this type to spawn"
          },
          "context_manager": {
            "type": "component",
            "default": null,
            "description": "Optional ContextManager config for this type"
          }
        },
        "source": "components/agents.py",
        "exposes": {
          "variables": {
            "id": "str \u2014 machine-readable identifier for this agent type",
            "displayName": "str \u2014 human-readable label",
            "count": "int \u2014 number of agents of this type"
          },
          "functions": {}
        }
      }
    }
  },
