  "WinCondition": {
    "description": "WinCondition components",
    "classes": {
      "WinCondition": {
        "description": "Declares a winner and the condition that triggers that outcome.\n\n    ``winner`` is the name of the agent group that wins (e.g. ``\"Crewmate\"``,\n    ``\"Imposter\"``).\n\n    ``condition`` is an optional Condition.  If *None*, this win condition\n    never fires on its own (useful when the game ends only by timer).",
        "params": {
          "winner": {
            "type": "str",
            "default": "''",
            "description": "Agent group that wins \u2014 must match an AgentType.id"
          },
          "condition": {
            "type": "component",
            "default": null,
            "description": "Condition that triggers this outcome (or null for timer-only)"
          }
        },
        "source": "components/win_conditions.py"
      }
    }
  },
