          },
          "tick_interval": {
            "type": "float",
            "default": "3.0",
            "description": "Seconds between agent decision ticks"
          },
          "actions": {
            "type": "list",
            "default": "[]",
            "description": "Actions available during this phase",
            "element_type": "ExperimentComponent"
          },
          "position_mode": {
            "type": "component",
            "default": null,
            "description": "Position mode for this phase (e.g. TilePosition)"
          },
          "min_time": {
            "type": "float",
