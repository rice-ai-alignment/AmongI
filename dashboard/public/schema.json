          }
        },
        "source": "components/conditions.py"
      },
      "AgentCountCheck": {
        "description": "Check the alive count of a named agent type.\n\n    Example: \"crewmates <= 1\" \u2192 AgentCountCheck(agent_type=\"Crewmate\", op=\"<=\", count=1)",
        "params": {
          "agent_type": {
            "type": "str",
            "default": "''",
            "description": "Name of the agent type to count"
          },
          "op": {
            "type": "str",
            "default": "'<='",
