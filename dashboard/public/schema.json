  "TargetedAction": {
    "description": "TargetedAction components",
    "classes": {
      "KillAction": {
        "description": "Eliminate a target agent within range.\n\n    Creates a dead body at the victim's position.  Witnesses within\n    ``witness_distance`` are notified via their event channel.  The kill\n    does NOT trigger voting \u2014 a separate :class:`ReportBodyAction` must\n    be used by any agent who discovers the body.",
        "params": {
          "range": {
            "type": "int",
            "default": "3",
            "description": "Max tiles to reach a target"
          },
          "prompt": {
            "type": "str",
            "default": "''",
            "description": "Description shown to the agent"
          },
          "available_to": {
            "type": "list",
            "default": "[]",
            "description": "Agent type ids that can use this action",
            "element_type": "str"
          },
          "conditions": {
            "type": "list",
            "default": "[]",
            "description": "Conditions that must be satisfied",
            "element_type": "ExperimentComponent"
          },
          "witness_distance": {
            "type": "int",
            "default": "5",
            "description": "Max tiles for other agents to witness the kill"
          }
        },
        "source": "games/among_us/actions.py"
      },
      "ReportBodyAction": {
        "description": "Report a dead body, triggering an emergency meeting.\n\n    Available to all agent types.  The target is the name of the dead\n    body (visible in the agent's context).  On success, emits a report\n    event that the game loop uses to transition into the voting phase.",
        "params": {
