      "VotingPhase": {
        "description": "Emergency meeting \u2014 agents discuss, vote, and eject one player.\n\n    After voting concludes, checks win conditions and transitions back to\n    PlayPhase (or ends the game).",
        "params": {
          "timeout": {
            "type": "float",
            "default": "30.0",
