  "ContextManager": {
    "description": "ContextManager components",
    "classes": {
      "ContextManager": {
        "description": "Configurable context builder \u2014 defines channels and prompt templates\n    for building agent context. One per agent type; the engine creates\n    runtime copies per agent from this template.",
        "params": {
          "base_prompt": {
            "type": "str",
            "default": "''",
            "description": "Base system prompt for all agents"
          },
          "channels": {
            "type": "list",
            "default": "[]",
            "description": "Channel definitions [{name, ctype}]"
          }
        },
        "source": "components/context_manager.py",
        "exposes": {
          "variables": {},
          "functions": {
            "build_prompt": {
              "args": [],
              "returns": "str",
              "desc": "Build the full prompt from all channels"
            },
            "build_messages": {
              "args": [],
              "returns": "list[dict]",
              "desc": "Build API-compatible messages from channels"
            }
          }
        }
      }
    }
