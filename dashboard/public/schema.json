  "ChatContext": {
    "description": "ChatContext components",
    "classes": {
      "ChatContext": {
        "description": "Encapsulates chat message routing between agents.\n\n    Handles proximity-based delivery, global chat history, and broadcast\n    behaviour. One instance per engine; routes chat from any agent to\n    nearby agents via their :class:`ContextManager` channels.\n\n    Config params:\n        chat_distance: max tiles for a message to reach another agent.\n                       Default is very large (10000), making chat global.",
        "params": {
          "chat_distance": {
            "type": "float",
            "default": "10000.0",
            "description": "Max tiles for chat delivery"
          }
        },
        "source": "components/context_manager.py"
      }
    }
  },
  "EventManager": {
    "description": "EventManager components",
    "classes": {
      "EventManager": {
        "description": "Handles event logging, render emission, and trace output.\n\n    The engine calls :meth:`emit` for every game event.  This method\n    writes to the JSONL log and pushes to the Godot renderer in one call.\n    Trace entries (LLM prompts, decisions) go through :meth:`trace`.",
        "params": {},
        "source": "components/event_manager.py"
      }
    }
  },
  "Game": {
    "description": "Game components",
    "classes": {
      "AmongUsGame": {
        "description": "Among Us \u2014 crewmates vs imposters with kills, voting, and ejection.\n\n    Phases:\n        PlayPhase \u2014 free-roam with movement, chat, and kills.\n        VotingPhase \u2014 emergency meeting triggered by a kill.",
