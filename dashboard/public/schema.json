      "PlayPhase": {
        "description": "Free-roam exploration \u2014 agents move, chat, and can kill.\n\n    A kill triggers an emergency meeting (transition to VotingPhase).",
        "params": {
          "timeout": {
            "type": "float",
            "default": "600.0",
