{
  "name": "Small Map — Kill Only",
  "description": "2 agents (1 crew + 1 impostor) on an 8×8 map. No voting — impostor wins by killing the crewmate. Minimal config showing kill conditions and distance checks.",
  "type": "Experiment",
  "class": "Experiment",
  "id": "small_kill",
  "references": [
    {"type": "Map", "class": "SquareMap", "id": "arena", "size": 8}
  ],
  "engine": {
    "type": "Engine", "class": "EngineConfig",
    "kill_distance": 2,
    "visibility_radius": 3,
    "witness_distance": 0,
    "win_conditions": [
      {"type": "WinCondition", "class": "WinCondition", "winner": "Crewmate",
       "condition": {"type": "Condition", "class": "Comparison", "op": "==",
        "left":  {"type": "Value", "class": "VariableRef", "path": "Imposter.alive_count"},
        "right": {"type": "Value", "class": "Literal", "value": 0}}},
      {"type": "WinCondition", "class": "WinCondition", "winner": "Imposter",
       "condition": {"type": "Condition", "class": "Comparison", "op": "==",
        "left":  {"type": "Value", "class": "VariableRef", "path": "Crewmate.alive_count"},
        "right": {"type": "Value", "class": "Literal", "value": 0}}}
    ],
    "agents": {
      "type": "AgentConfig", "class": "AgentConfig",
      "types": [
        {"type": "AgentType", "class": "AgentType", "id": "Crewmate", "displayName": "Crewmate",
         "prompt": "You are a crewmate. Survive.", "count": 1,
         "context_manager": {"type": "ContextManager", "class": "ContextManager",
          "channels": [{"name": "system", "ctype": "constant"}, {"name": "chat", "ctype": "continuous"}]}},
        {"type": "AgentType", "class": "AgentType", "id": "Imposter", "displayName": "Imposter",
         "prompt": "You are an impostor. Kill the crewmate.", "count": 1,
         "context_manager": {"type": "ContextManager", "class": "ContextManager",
          "channels": [{"name": "system", "ctype": "constant"}, {"name": "chat", "ctype": "continuous"}]}}
      ]
    }
  },
  "free_roam": {
    "type": "Phase", "class": "FreeRoamPhase",
    "tick_interval": 2.0, "max_duration": 300.0,
    "position_mode": {"type": "Position", "class": "TilePosition",
      "map": {"type": "Ref", "class": "Ref", "ref": "arena"}},
    "actions": [
      {"type": "AgentAction", "class": "MoveAction", "range": 1, "available_to": ["Crewmate", "Imposter"]},
      {"type": "AgentAction", "class": "AttackAction", "range": 2, "available_to": ["Imposter"],
       "conditions": [{
         "type": "Condition", "class": "AgentCountCheck",
         "agent_type": "Crewmate", "op": ">", "count": 0
       }]}
    ]
  }
}
