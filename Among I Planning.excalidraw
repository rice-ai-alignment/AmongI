      "text": "Game Types:\n- Among Us*\n- Hide and Seek\n- Rock, Paper, Scissors",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Game Types:\n- Among Us*\n- Hide and Seek\n- Rock, Paper, Scissors",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "J9Hl7fSVscRN70-R4g7F7",
      "type": "text",
      "x": 992.58203125,
      "y": -129.888671875,
      "width": 772.3993530273438,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
