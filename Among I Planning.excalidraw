      "versionNonce": 1998975070,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785909799640,
      "link": null,
      "locked": false,
      "text": "The current idea is that we have a tree of parameters\nso for example the top level parameter is the game type (Ex: Among us) \nand that has a bunch of paramters to set such as the map, distance values\nprompts and such. These parameters could also have there own parameters so \nwould end up with a bunch of puzzle pieces we could tie together",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The current idea is that we have a tree of parameters\nso for example the top level parameter is the game type (Ex: Among us) \nand that has a bunch of paramters to set such as the map, distance values\nprompts and such. These parameters could also have there own parameters so \nwould end up with a bunch of puzzle pieces we could tie together",
      "autoResize": true,
      "lineHeight": 1.25
    },
